"use strict";
document.addEventListener("DOMContentLoaded", function() {
    var table = document.querySelector(".sortable");
    var headers = table.querySelectorAll("th");
    var tbody = table.querySelector("tbody");
    // Ініціалізація напрямку сортування: true — ASC, false — DESC
    var sortDirections = Array.from(headers).map(function() {
        return true;
    });
    headers.forEach(function(header, index) {
        header.addEventListener("click", function() {
            var rows = Array.from(tbody.querySelectorAll("tr"));
            // Перемикання напрямку сортування
            var ascending = sortDirections[index];
            sortDirections[index] = !ascending;
            // Сортуємо рядки
            rows.sort(function(a, b) {
                var cellA = a.children[index].textContent.trim();
                var cellB = b.children[index].textContent.trim();
                var isNumeric = !isNaN(cellA) && !isNaN(cellB);
                if (isNumeric) return ascending ? Number(cellA) - Number(cellB) : Number(cellB) - Number(cellA);
                else return ascending ? cellA.localeCompare(cellB) : cellB.localeCompare(cellA);
            });
            // Оновлюємо DOM
            tbody.innerHTML = "";
            rows.forEach(function(row) {
                return tbody.appendChild(row);
            });
            // Стрілочки 🔽🔼
            headers.forEach(function(h, i) {
                h.textContent = h.textContent.replace(/[\u2191\u2193]/g, "");
